[{"id": "01_data", "title": "From prices to daily returns", "cells": [{"n": 1, "lines": ["import pandas as pd", "import numpy as np"], "outputs": []}, {"n": 2, "lines": ["btc = pd.read_csv(\"../data_raw/btc.csv\", usecols=[\"time\", \"PriceUSD\"], parse_dates=[\"time\"])", "btc = btc.rename(columns={\"time\": \"date\", \"PriceUSD\": \"price\"}).set_index(\"date\")", "btc = btc.loc[\"2017-09-01\":\"2025-12-31\"]", "print(len(btc), btc.index.min(), btc.index.max(), btc[\"price\"].isna().sum())"], "outputs": [{"kind": "text", "text": "3044 2017-09-01 00:00:00 2025-12-31 00:00:00 0"}]}, {"n": 3, "lines": ["btc[\"ret\"] = btc[\"price\"].pct_change()", "r = btc.loc[\"2018\":\"2025\", \"ret\"]", "print(r.mean(), r.std(), r.min(), r.idxmin())"], "outputs": [{"kind": "text", "text": "0.0012212869405938628 0.0341958520865199 -0.3753495151221997 2020-03-12 00:00:00"}]}, {"n": 4, "lines": ["btc[\"price\"].plot(logy=True, title=\"BTC price, log scale\")", "btc.to_csv(\"../data_clean/btc_clean.csv\")"], "outputs": [{"kind": "image", "src": "/nb/01_data-4-1.png"}]}]}, {"id": "02_stats", "title": "Risk statistics and the risk-free rate", "cells": [{"n": 1, "lines": ["import pandas as pd", "import numpy as np", "", "btc = pd.read_csv(\"../data_clean/btc_clean.csv\", index_col=\"date\", parse_dates=True)", "r = btc.loc[\"2018\":\"2025\", \"ret\"]"], "outputs": []}, {"n": 2, "lines": ["wealth = (1 + r).cumprod()                      # growth of 1 USD, compounding", "dd = wealth / wealth.cummax() - 1               # drawdown: distance below the highest point so far", "q = r.quantile(0.05)                            # VaR 95%: the cut-off for the worst 5% of days", "", "stats = {", "    \"annual vol\": r.std() * np.sqrt(365),", "    \"CAGR\": wealth.iloc[-1] ** (365 / len(r)) - 1,", "    \"max drawdown\": dd.min(),", "    \"VaR 95%\": -q,", "    \"CVaR 95%\": -r[r <= q].mean(),              # average of the worst 5% of days", "    \"skew\": r.skew(),", "    \"excess kurtosis\": r.kurt(),", "}", "pd.Series(stats).round(4)"], "outputs": [{"kind": "text", "text": "annual vol         0.6533\nCAGR               0.2582\nmax drawdown      -0.8138\nVaR 95%            0.0522\nCVaR 95%           0.0793\nskew              -0.2851\nexcess kurtosis    8.1945\ndtype: float64"}]}, {"n": 3, "lines": ["r.plot(title=\"BTC daily returns\", figsize=(10, 3))", "", "(r.rolling(30).std() * np.sqrt(365)).plot(title=\"30-day volatility, annualised\", figsize=(10, 3))"], "outputs": [{"kind": "image", "src": "/nb/02_stats-3-1.png"}]}, {"n": 4, "lines": ["rf = pd.read_csv(\"../data_raw/dtb3.csv\", index_col=0, parse_dates=True, na_values=\".\").iloc[:, 0]", "rf = rf.reindex(pd.date_range(\"2017-09-01\", \"2025-12-31\")).ffill().shift(1) / 100", "rf_daily = (1 + rf) ** (1 / 365) - 1", "print(rf.loc[\"2018\":\"2025\"].mean())", "rf_daily.rename(\"rf\").to_csv(\"../data_clean/rf_daily.csv\")"], "outputs": [{"kind": "text", "text": "0.025631074606433952"}]}]}, {"id": "03_momentum", "title": "Momentum: in-sample and out-of-sample", "cells": [{"n": 1, "lines": ["import pandas as pd", "import numpy as np", "import statsmodels.api as sm", "", "btc = pd.read_csv(\"../data_clean/btc_clean.csv\", index_col=\"date\", parse_dates=True)", "p, r = btc[\"price\"], btc[\"ret\"]", "", "df = pd.DataFrame({", "    \"y\":   r.shift(-1),              # tomorrow's return (the thing we predict)", "    \"mom\": p / p.shift(30) - 1,      # 30-day momentum, known today", "    \"vol\": r.rolling(30).std(),      # 30-day volatility, known today", "})", "train = df.loc[\"2018\":\"2021\"].dropna()", "print(len(train))"], "outputs": [{"kind": "text", "text": "1461"}]}, {"n": 2, "lines": ["X = sm.add_constant(train[[\"mom\", \"vol\"]])     # adds the intercept a", "model = sm.OLS(train[\"y\"], X).fit(cov_type=\"HAC\", cov_kwds={\"maxlags\": 30})", "print(model.params.round(5))", "print(model.tvalues.round(2))", "print(model.rsquared)"], "outputs": [{"kind": "text", "text": "const    0.00029\nmom      0.00194\nvol      0.03414\ndtype: float64\nconst    0.09\nmom      0.46\nvol      0.43\ndtype: float64\n0.00026021003869713955"}]}, {"n": 3, "lines": ["data = df.loc[\"2018\":\"2025-12-30\"].dropna()", "rows = []", "for t in data.loc[\"2022\":].index:", "    past = data.loc[:t].iloc[:-1]       # rows before today: their \"tomorrow\" is already known", "    m = sm.OLS(past[\"y\"], sm.add_constant(past[[\"mom\", \"vol\"]])).fit()", "    x_today = [1, data.loc[t, \"mom\"], data.loc[t, \"vol\"]]", "    rows.append({", "        \"date\": t,", "        \"model\": np.dot(m.params.values, x_today),   # momentum forecast for tomorrow", "        \"bench\": r.loc[\"2018\":t].mean(),             # benchmark: average return so far", "        \"actual\": data.loc[t, \"y\"],                  # what really happened tomorrow", "    })", "oos = pd.DataFrame(rows).set_index(\"date\")", "print(len(oos))"], "outputs": [{"kind": "text", "text": "1460"}]}, {"n": 4, "lines": ["def score(d):", "    em, eb = d[\"actual\"] - d[\"model\"], d[\"actual\"] - d[\"bench\"]      # forecast errors", "    r2 = 1 - (em**2).sum() / (eb**2).sum()", "    f = eb**2 - (em**2 - (d[\"bench\"] - d[\"model\"])**2)               # Clark–West adjustment", "    cw = sm.OLS(f, np.ones(len(f))).fit(cov_type=\"HAC\", cov_kwds={\"maxlags\": 30})", "    return round(r2 * 100, 3), round(cw.tvalues.iloc[0], 2)", "", "print(\"validation 2022-23:\", score(oos.loc[\"2022\":\"2023\"]))", "print(\"test 2024-25:      \", score(oos.loc[\"2024\":\"2025\"]))"], "outputs": [{"kind": "text", "text": "validation 2022-23: (np.float64(0.009), np.float64(0.42))\ntest 2024-25:       (np.float64(-0.017), np.float64(0.19))"}]}, {"n": 5, "lines": ["oos.to_csv(\"../outputs/momentum_oos.csv\")"], "outputs": []}]}, {"id": "04_volatility", "title": "Forecasting volatility", "cells": [{"n": 1, "lines": ["import pandas as pd", "import numpy as np", "import statsmodels.api as sm", "", "btc = pd.read_csv(\"../data_clean/btc_clean.csv\", index_col=\"date\", parse_dates=True)", "r = btc[\"ret\"].dropna()          # starts Sep 2017: the warm-up months matter here"], "outputs": []}, {"n": 2, "lines": ["roll = (r**2).rolling(30).mean()         # forecast for tomorrow = average of the last 30 squared returns", "", "def ewma(r, lam):", "    v = (r.loc[:\"2017-12-31\"]**2).mean() # starting value: average squared return in the warm-up", "    out = []", "    for x in r:", "        v = lam * v + (1 - lam) * x**2   # keep λ of the old belief, mix in (1-λ) of today's news", "        out.append(v)", "    return pd.Series(out, index=r.index)"], "outputs": []}, {"n": 3, "lines": ["def qlike(fc, r, start, end):", "    d = pd.concat([fc, r.shift(-1)], axis=1).loc[start:end].dropna()", "    d.columns = [\"f\", \"y\"]", "    return np.log(d.f) + d.y**2 / d.f        # one score per day; lower is better", "", "print(\"rolling\", round(qlike(roll, r, \"2022\", \"2023\").mean(), 4))", "for lam in [0.90, 0.94, 0.97]:", "    print(lam, round(qlike(ewma(r, lam), r, \"2022\", \"2023\").mean(), 4))"], "outputs": [{"kind": "text", "text": "rolling -5.9977\n0.9 -6.0395\n0.94 -6.0922\n0.97 -6.1351"}]}, {"n": 4, "lines": ["ew = ewma(r, 0.97)", "q_roll = qlike(roll, r, \"2024\", \"2025-12-30\")", "q_ew   = qlike(ew,   r, \"2024\", \"2025-12-30\")", "print(\"QLIKE rolling:\", round(q_roll.mean(), 4), \" EWMA:\", round(q_ew.mean(), 4))", "", "d = q_roll - q_ew                                # positive = EWMA did better that day", "dm = sm.OLS(d.values, np.ones(len(d))).fit(cov_type=\"HAC\", cov_kwds={\"maxlags\": 6})", "print(\"DM t:\", round(dm.tvalues[0], 2))"], "outputs": [{"kind": "text", "text": "QLIKE rolling: -6.3612  EWMA: -6.4104\nDM t: 2.45"}]}, {"n": 5, "lines": ["fc = pd.DataFrame({\"roll\": roll, \"ewma\": ew})", "fc.to_csv(\"../data_clean/vol_forecasts.csv\")", "(np.sqrt(fc * 365)).loc[\"2022-10-15\":\"2022-12-31\"].plot(title=\"Forecast volatility around FTX (annualised)\")"], "outputs": [{"kind": "image", "src": "/nb/04_volatility-5-1.png"}]}]}, {"id": "05_strategy", "title": "The strategy backtest and robustness", "cells": [{"n": 1, "lines": ["import pandas as pd", "import numpy as np", "", "btc = pd.read_csv(\"../data_clean/btc_clean.csv\", index_col=\"date\", parse_dates=True)", "rf  = pd.read_csv(\"../data_clean/rf_daily.csv\", index_col=0, parse_dates=True)[\"rf\"]", "fc  = pd.read_csv(\"../data_clean/vol_forecasts.csv\", index_col=0, parse_dates=True)", "r = btc[\"ret\"]"], "outputs": []}, {"n": 2, "lines": ["sig = np.sqrt(fc[\"ewma\"] * 365)                              # tomorrow's forecast, annualised", "w_vt = np.minimum(1, 0.30 / sig)                             # vol targeting: 30% ÷ forecast, max 100%", "w_fix = 0.30 / (r.loc[\"2018\":\"2021\"].std() * np.sqrt(365))   # fixed mix, calibrated on training years", "print(round(w_fix, 3), round(w_vt.loc[\"2024\":\"2025\"].mean(), 3))"], "outputs": [{"kind": "text", "text": "0.391 0.666"}]}, {"n": 3, "lines": ["def backtest(w_target, cost=0.0025, start=\"2022-01-01\", end=\"2025-12-31\", lag=1):", "    rows, w_drift = [], None", "    for t in r.loc[start:end].index:", "        w = w_target.loc[t - pd.Timedelta(days=lag)]          # lag=2 means we trade a day late ", "        to = w if w_drift is None else abs(w - w_drift)       # how much we trade to reach w", "        gross = w * r[t] + (1 - w) * rf[t]                    # BTC part + cash part", "        net = gross - cost * to                               # pay trading costs", "        w_drift = w * (1 + r[t]) / (w * (1 + r[t]) + (1 - w) * (1 + rf[t]))  # weight after today's move", "        rows.append((t, net, to, w))", "    return pd.DataFrame(rows, columns=[\"date\", \"ret\", \"to\", \"w\"]).set_index(\"date\")"], "outputs": []}, {"n": 4, "lines": ["def metrics(x, a, b):", "    d = x.loc[a:b]", "    ex = d.ret - rf.loc[a:b]                                  # return above cash", "    wealth = (1 + d.ret).cumprod()", "    return pd.Series({", "        \"CAGR\": wealth.iloc[-1] ** (365 / len(d)) - 1,", "        \"vol\": d.ret.std() * np.sqrt(365),", "        \"Sharpe\": ex.mean() / ex.std() * np.sqrt(365),", "        \"max DD\": (wealth / wealth.cummax() - 1).min(),", "        \"turnover/yr\": d.to.iloc[1:].sum() / (len(d) / 365),", "        \"avg weight\": d.w.mean(),", "    })", "", "strategies = {", "    \"buy&hold\":   pd.Series(1.0, index=r.index),", "    \"fixed mix\":  pd.Series(w_fix, index=r.index),", "    \"vol target\": w_vt,", "}", "runs = {name: backtest(w) for name, w in strategies.items()}", "print(pd.DataFrame({n: metrics(x, \"2024\", \"2025\") for n, x in runs.items()}).round(3))"], "outputs": [{"kind": "text", "text": "             buy&hold  fixed mix  vol target\nCAGR            0.439      0.212       0.270\nvol             0.478      0.187       0.306\nSharpe          0.907      0.886       0.788\nmax DD         -0.321     -0.135      -0.270\nturnover/yr     0.000      1.557       4.176\navg weight      1.000      0.391       0.666"}]}, {"n": 5, "lines": ["for c in [0.001, 0.005]:", "    res = {n: metrics(backtest(w, cost=c), \"2024\", \"2025\")[\"Sharpe\"] for n, w in strategies.items()}", "    print(f\"{c*1e4:.0f} bp:\", {k: round(v, 3) for k, v in res.items()})", "print(\"2022-25:\", {n: round(metrics(x, \"2022\", \"2025\")[\"Sharpe\"], 3) for n, x in runs.items()})"], "outputs": [{"kind": "text", "text": "10 bp: {'buy&hold': np.float64(0.907), 'fixed mix': np.float64(0.898), 'vol target': np.float64(0.808)}\n50 bp: {'buy&hold': np.float64(0.907), 'fixed mix': np.float64(0.865), 'vol target': np.float64(0.754)}\n2022-25: {'buy&hold': np.float64(0.488), 'fixed mix': np.float64(0.468), 'vol target': np.float64(0.556)}"}]}, {"n": 6, "lines": ["pd.DataFrame({n: (1 + x.loc[\"2024\":\"2025\", \"ret\"]).cumprod() for n, x in runs.items()}).plot(", "    logy=True, title=\"Growth of 1 USD, 2024-2025 (net of 25 bp costs)\")"], "outputs": [{"kind": "image", "src": "/nb/05_strategy-6-1.png"}]}, {"n": 7, "lines": ["def ewma(r, lam):                                        # copied from 04_volatility", "    v = (r.loc[:\"2017-12-31\"]**2).mean(); out = []", "    for x in r:", "        v = lam*v + (1-lam)*x**2; out.append(v)", "    return pd.Series(out, index=r.index)", "", "train_vol = r.loc[\"2018\":\"2021\"].std() * np.sqrt(365)", "def vt(lam=0.97, target=0.30):", "    return np.minimum(1, target / np.sqrt(ewma(r.dropna(), lam) * 365))", "def fix(target=0.30):", "    return pd.Series(target / train_vol, index=r.index)", "def sh(x, a=\"2024\", b=\"2025\"):", "    return metrics(x, a, b)[\"Sharpe\"]", "", "cases = {", "    \"base\":        (vt(),            fix(),     1),", "    \"λ 0.94\":      (vt(lam=0.94),    fix(),     1),", "    \"λ 0.98\":      (vt(lam=0.98),    fix(),     1),", "    \"target 25%\":  (vt(target=0.25), fix(0.25), 1),", "    \"target 35%\":  (vt(target=0.35), fix(0.35), 1),", "    \"2-day delay\": (vt(),            fix(),     2),", "}", "rob = {k: {\"vol target\": sh(backtest(a, lag=l)), \"fixed mix\": sh(backtest(f, lag=l))}", "       for k, (a, f, l) in cases.items()}", "print(pd.DataFrame(rob).T.round(3))"], "outputs": [{"kind": "text", "text": "             vol target  fixed mix\nbase              0.788      0.886\nλ 0.94            0.770      0.886\nλ 0.98            0.790      0.886\ntarget 25%        0.782      0.884\ntarget 35%        0.804      0.888\n2-day delay       0.759      0.886"}]}, {"n": 8, "lines": ["for y in [\"2022\", \"2023\", \"2024\", \"2025\"]:", "    print(y, {n: round(metrics(x, y, y)[\"Sharpe\"], 2) for n, x in runs.items()})"], "outputs": [{"kind": "text", "text": "2022 {'buy&hold': np.float64(-1.33), 'fixed mix': np.float64(-1.35), 'vol target': np.float64(-1.49)}\n2023 {'buy&hold': np.float64(2.25), 'fixed mix': np.float64(2.23), 'vol target': np.float64(2.13)}\n2024 {'buy&hold': np.float64(1.67), 'fixed mix': np.float64(1.65), 'vol target': np.float64(1.74)}\n2025 {'buy&hold': np.float64(-0.04), 'fixed mix': np.float64(-0.06), 'vol target': np.float64(-0.21)}"}]}, {"n": 9, "lines": ["ex_vt = (runs[\"vol target\"].loc[\"2024\":\"2025\", \"ret\"] - rf.loc[\"2024\":\"2025\"]).values", "ex_fx = (runs[\"fixed mix\"].loc[\"2024\":\"2025\", \"ret\"] - rf.loc[\"2024\":\"2025\"]).values", "def sr(x): return x.mean() / x.std() * np.sqrt(365)", "", "rng = np.random.default_rng(42)                 # fixed seed, so you get my numbers", "n, B, diffs = len(ex_vt), 20, []", "for _ in range(5000):                           # 5,000 \"alternative histories\"", "    starts = rng.integers(0, n - B + 1, int(np.ceil(n / B)))", "    ix = np.concatenate([np.arange(s, s + B) for s in starts])[:n]", "    diffs.append(sr(ex_vt[ix]) - sr(ex_fx[ix]))", "print(round(sr(ex_vt) - sr(ex_fx), 3), np.percentile(diffs, [2.5, 97.5]).round(2))"], "outputs": [{"kind": "text", "text": "-0.098 [-0.3  0.1]"}]}]}]